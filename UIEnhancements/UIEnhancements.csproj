<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="UIEnhancements.csproj" Condition="Exists('UIEnhancements.csproj')"/>
    <Import Project="UIEnhancements.csproj.user" Condition="Exists('UIEnhancements.csproj.user')"/>

    <PropertyGroup>
        <TargetFramework>net472</TargetFramework>
        <LangVersion>latest</LangVersion>
        <EnableFrameworkPathOverride>true</EnableFrameworkPathOverride>
        <FrameworkPathOverride>$(BeatSaberDir)\Beat Saber_Data\Managed</FrameworkPathOverride>
        <MarkPackageReferencesAsExternallyResolved>false</MarkPackageReferencesAsExternallyResolved>
        <RootNamespace>UIEnhancements</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="BeatSaberModdingTools.Tasks" Version="2.0.0-beta7">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <None Include="UIEnhancements.csproj"/>
        <None Include="UIEnhancements.csproj.user" Condition="Exists('UIEnhancements.csproj.user')" />
    </ItemGroup>

    <ItemGroup>
        <Reference Include="0Harmony">
